{% extends 'site/base.html.twig' %}

{% block title %}
    {{ parent() }} | Forums
{% endblock %}

{% block body %}
    <div class="page-header d-print-none" aria-label="Page header">
        <div class="container-xl">
            <div class="row g-2 align-items-center justify-content-between">
                <div class="col">
                    <h2 class="page-title">
                        Forums
                    </h2>
                </div>
                {% if is_granted('ROLE_USER') %}
                    <div class="col-auto">
                        <a href="{{ path('site_forum_create') }}" class="btn btn-primary">
                            Criar Novo Fórum
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                {% for forum in forums %}
                    <div class="col-lg-6">
                        <a class="card card-link" href="{{ path('site_forum_show', {'id': forum.id}) }}">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col">
                                        <h3 class="card-title mb-1">
                                            {{ forum.title }}
                                        </h3>
                                        <div class="text-secondary">
                                            {{ forum.content|raw }}
                                        </div>
                                        <div class="mt-3">
                                            <div class="row g-2 align-items-center">
                                                <div class="col-auto">
                                                    {{ forum.comments|length }} Posts
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-info">
                            <span class="fw-bold">Sem Fóruns!</span> Não há fóruns disponíveis no momento.
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% if forums.haveToPaginate %}
                <div class="row mt-3">
                    <div class="col-12">
                        {{ pagerfanta(forums) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
